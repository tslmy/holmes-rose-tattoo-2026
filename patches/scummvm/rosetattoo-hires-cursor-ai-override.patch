Add AI-upscaled true-color room cursor override for Rose Tattoo hires mode.

Rationale: the existing Rose Tattoo hires-mode cursor fix (see
rosetattoo-hires-cursor-fix.patch) only fixed *coordinate* scaling -
Events::setCursor() nearest-neighbor-replicates the original low-res,
8-bit palettized cursor pixels by the hires scale factor, so the cursor
stays correctly proportioned relative to the enlarged window, but its
underlying pixel art is still the original tiny bitmap blown up with
hard square edges (blocky, not actually higher resolution).

This patch adds an opt-in override path that, when configured, loads a
real AI-upscaled, true-color RGBA cursor frame (produced by
tools/extract_rosetattoo_sprites.py + tools/upscale_rosetattoo_sprites.py
from the game's own RMOUSE.VGS resource) instead of nearest-neighbor
scaling the palettized source. The override is looked up by CursorId,
which lines up 1:1 with RMOUSE.VGS's frame index, so no additional
lookup table or asset metadata is needed at runtime.

Override files are expected at:
  $SCUMMVM_SHERLOCK_TATTOO_ASSET_OVERRIDES/sprites/rmouse_vgs/frame_NNN@Sx.png
(NNN = zero-padded CursorId, Sx = the active SCUMMVM_SHERLOCK_TATTOO_HIRES_SCALE)
mirroring the existing background override convention
(scene_NNN/background@Sx.png). When the override directory/env var isn't
set, or the specific frame file is missing, this silently falls back to
the existing nearest-neighbor-scaled cursor path - no behavior change
for anyone not using --asset-overrides.

Uses Graphics::PixelFormat::createFormatRGBA32() (the same endian-aware
factory the rest of the codebase uses) for the decoded override surface,
and calls CursorMan.replaceCursor() with a real per-pixel alpha channel
and no color-key/mask, exactly like the existing hires background
compositor already does for true-color surfaces - this lets the
platform backend (SurfaceSdlGraphicsManager::setMouseCursor(), see
backends/graphics/surfacesdl/surfacesdl-graphics.cpp) draw the cursor
with correct alpha blending via SDL_SRCALPHA rather than relying on an
(easily mismatched) exact color-key match.

--- a/engines/sherlock/screen.h
+++ b/engines/sherlock/screen.h
@@ -211,5 +211,17 @@ public:
 	int roseTattooHiresScale() const { return _roseTattooHiresScale; }
 	bool loadRoseTattooHiresBackgroundOverride(int sceneNumber);
 	void clearRoseTattooHiresBackground();
+
+	/**
+	 * Attempts to load a true-color, AI-upscaled cursor frame override for
+	 * the given VGS resource ("rmouse_vgs"/"omouse_vgs") and frame index
+	 * (which lines up 1:1 with CursorId - see tools/extract_rosetattoo_sprites.py).
+	 * On success, fills in outSurface (owned by the caller) at native
+	 * (hiresScale-multiplied) resolution and returns true; the pixel format
+	 * is always kRGBA8888 with real per-pixel alpha (transparent pixels are
+	 * fully transparent, never a color-keyed sentinel).
+	 */
+	bool loadRoseTattooHiresCursorOverride(const Common::String &resourceName, int frameIndex,
+		Graphics::Surface &outSurface);
 };
 
--- a/engines/sherlock/screen.cpp
+++ b/engines/sherlock/screen.cpp
@@ -262,3 +262,61 @@ bool Screen::loadRoseTattooHiresBackgroundOverride(int sceneNumber) {
 	return true;
 }
+
+bool Screen::loadRoseTattooHiresCursorOverride(const Common::String &resourceName, int frameIndex,
+		Graphics::Surface &outSurface) {
+	if (_roseTattooHiresScale <= 1)
+		return false;
+
+	const char *overrideDir = getenv("SCUMMVM_SHERLOCK_TATTOO_ASSET_OVERRIDES");
+	if (!overrideDir || !*overrideDir)
+		return false;
+
+	Common::Path overridePath(Common::String::format(
+		"%s/sprites/%s/frame_%03d@%dx.png", overrideDir, resourceName.c_str(), frameIndex,
+		_roseTattooHiresScale), '/');
+	Common::File file;
+	if (!file.open(Common::FSNode(overridePath)))
+		return false;
+
+	Image::PNGDecoder decoder;
+	if (!decoder.loadStream(file)) {
+		warning("Could not decode Rose Tattoo hires cursor override: %s",
+			overridePath.toString(Common::Path::kNativeSeparator).c_str());
+		return false;
+	}
+
+	const Graphics::Surface *surface = decoder.getSurface();
+	if (!surface || !surface->w || !surface->h)
+		return false;
+
+	const Graphics::PixelFormat rgba8888 = Graphics::PixelFormat::createFormatRGBA32();
+	outSurface.create(surface->w, surface->h, rgba8888);
+
+	const Graphics::Palette &sourcePalette = decoder.getPalette();
+	const byte *sourcePaletteData = sourcePalette.data();
+	const bool hasAlpha = decoder.hasTransparentColor() || surface->format.aBits() > 0;
+
+	for (int y = 0; y < surface->h; ++y) {
+		for (int x = 0; x < surface->w; ++x) {
+			uint32 color = surface->getPixel(x, y);
+			byte r, g, b, a = 255;
+
+			if (surface->format.bytesPerPixel == 1 && sourcePaletteData && color < sourcePalette.size()) {
+				r = sourcePaletteData[color * 3];
+				g = sourcePaletteData[color * 3 + 1];
+				b = sourcePaletteData[color * 3 + 2];
+				if (decoder.hasTransparentColor() && color == decoder.getTransparentColor())
+					a = 0;
+			} else {
+				surface->format.colorToARGB(color, a, r, g, b);
+				if (!hasAlpha)
+					a = 255;
+			}
+
+			outSurface.setPixel(x, y, rgba8888.ARGBToColor(a, r, g, b));
+		}
+	}
+
+	return true;
+}
 
--- a/engines/sherlock/events.cpp
+++ b/engines/sherlock/events.cpp
@@ -82,5 +82,25 @@ void Events::setCursor(CursorId cursorId) {
 		hotspotY = 0;
 	}
 
+	// Prefer an AI-upscaled, true-color cursor override if one is available
+	// (see tools/extract_rosetattoo_sprites.py / upscale_rosetattoo_sprites.py):
+	// the frame index in RMOUSE.VGS lines up 1:1 with CursorId, so no lookup
+	// table is needed. Falls back to the nearest-neighbor-scaled palettized
+	// cursor below when no override is configured/found.
+	if (!IS_3DO) {
+		const int hiresScale = _vm->_screen->roseTattooHiresScale();
+		if (hiresScale > 1 && cursorId >= 0) {
+			Graphics::Surface overrideSurface;
+			if (_vm->_screen->loadRoseTattooHiresCursorOverride(
+					"rmouse_vgs", (int)cursorId, overrideSurface)) {
+				CursorMan.replaceCursor(overrideSurface, hotspotX * hiresScale,
+					hotspotY * hiresScale, 0);
+				overrideSurface.free();
+				_cursorId = cursorId;
+				return;
+			}
+		}
+	}
+
 	// Set the cursor data
 	Graphics::Surface &s = (*_cursorImages)[cursorId]._frame;
