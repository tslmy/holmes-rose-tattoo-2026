+static void queueRoseTattooHiresObjectOverride(Screen &screen, Object &obj) {
+	Common::String resourceName;
+	int frameIndex;
+	if (resolveRoseTattooHiresSpriteOverride(obj._images, obj._imageFrame, resourceName, frameIndex)) {
