# Start asset-safe: ignore everything, then allow only project scaffolding.
/*

!/.gitignore
!/README.md
!/CLAUDE.md
!/.github/
!/.github/**
!/docs/
!/docs/**
!/site/
!/site/**
!/tools/
!/tools/**
!/profiles/
!/profiles/**
!/thor-package/
!/thor-package/**
!/pyproject.toml
!/remaster.toml
!/review/
!/review/queue.md
!/review/queue.json
!/uv.lock
!/.gitmodules
!/scummvm-src

# Built site and its game-derived images: published to gh-pages only, never to main.
/site/_build/

# Common local/generated noise within allowed directories.
.DS_Store
__pycache__/
*.py[cod]
.venv/

# These are intentionally left local even if the root allow-list changes later.
/scummvm/
/cd/
/extracted/
/enhanced/
/generated/
/validation/
/mods/
/models/
/tmp/
/work/
/review/*
!/review/queue.md
!/review/queue.json
