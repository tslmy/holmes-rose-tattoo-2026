# Start asset-safe: ignore everything, then allow only project scaffolding.
/*

!/.gitignore
!/README.md
!/.github/
!/.github/**
!/docs/
!/docs/**
!/tools/
!/tools/**
!/profiles/
!/profiles/**
!/thor-package/
!/thor-package/**
!/pyproject.toml
!/uv.lock
!/.gitmodules
!/scummvm-src

# Common local/generated noise within allowed directories.
.DS_Store
__pycache__/
*.py[cod]
.venv/

# These are intentionally left local even if the root allow-list changes later.
/scummvm/
/cd/
/extracted/
/enhanced/
/generated/
/validation/
/mods/
/models/
/tmp/
